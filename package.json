    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^17.14.0"
  },
  "devDependencies": {
    "@sequencemedia/eslint-config-standard": "^0.3.4",
    "@types/chai": "^5.2.3",
